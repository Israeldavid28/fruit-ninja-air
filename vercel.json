{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend_web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "^/$", "dest": "/frontend_web/index.html" },
    { "src": "^/([a-z]+)\\.html$", "dest": "/frontend_web/$1.html" },
    { "src": "/(.*)", "dest": "/frontend_web/$1" }
  ]
}
